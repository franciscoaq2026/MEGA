# Copie para .env e preencha (ou defina como variáveis de ambiente).
# Sem estas variáveis, o backend usa um SQLite local (bom para desenvolver).

# Turso / libSQL — necessário em produção (Vercel). Pegue os dois valores com:
#   turso db show <seu-banco> --url
#   turso db tokens create <seu-banco>
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=seu-token-aqui

# Opcional: caminho do arquivo SQLite local (padrão: backend/data/megasena.db)
# MEGASENA_DB_PATH=./data/megasena.db
